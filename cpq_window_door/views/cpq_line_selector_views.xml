<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="view_cpq_line_selector_form" model="ir.ui.view">
    <field name="name">cpq.line.selector.form</field>
    <field name="model">cpq.line.selector</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group>
            <field name="order_id" invisible="1"/>
            <field name="line_id" string="Product to configure"/>
            <field name="line_summary" string="Current configuration"
                   readonly="1" placeholder="Not configured"/>
          </group>
        </sheet>
        <footer>
          <button name="action_open_configurator" type="object"
                  string="⚙ Open configurator" class="btn-primary"/>
          <button special="cancel" string="Cancel" class="btn-secondary"/>
        </footer>
      </form>
    </field>
  </record>

</odoo>
